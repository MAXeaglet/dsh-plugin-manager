{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Plugin Manager",
  "version": "0.2.3",
  "identifier": "com.maxeagle.dsh-plugin-manager",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "DSH Plugin Manager",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}